# ==========================================
# Razorpay Agent Connector Configuration
# ==========================================

# Freshdesk Credentials
# Your Freshdesk domain (e.g., yourcompany.freshdesk.com)
FRESHDESK_DOMAIN=demo-merchant.freshdesk.com

# Freshdesk API Key (found in Profile Settings -> View API Key)
FRESHDESK_API_KEY=sample_freshdesk_api_key_xyz123

# Inbound Connector Authentication
# The secret API key required by AI agents or clients to call this connector API
CONNECTOR_API_KEY=rzp_agent_secret_key_987654321

# Mock/Demo Mode Toggle
# When true, the connector uses synthetic realistic merchant support data instead of calling Freshdesk API
FRESHDESK_MOCK_MODE=true

# Operational Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=50
